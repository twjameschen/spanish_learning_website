{
  "name": "camino-a-quito",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Camino a Quito — 離線西班牙文學習網站（拉美／厄瓜多 Sierra 變體）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run validate:content && vite build",
    "build:single": "tsc -b && npm run validate:content && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run src/content"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
    "idb": "8.0.3",
    "lucide-react": "0.462.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "tailwind-merge": "3.6.0",
    "ts-fsrs": "5.4.1",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
